# .env.example — ШАБЛОН (этот файл в git, .env — нет!)
# Команда для начала работы:
# cp .env.example backend/.env
# Затем отредактируйте backend/.env заполнив реальные значения

# ─── Окружение ──────────────────────────────────────────────
APP_ENV=development

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=marketplace_db
POSTGRES_USER=marketplace_user
# ⚠️ Сгенерируйте: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Полная строка подключения для backend
DATABASE_URL=postgresql+asyncpg://marketplace_user:CHANGE_ME_strong_password@postgres:5432/marketplace_db

# ─── Redis ──────────────────────────────────────────────────
# ⚠️ Сгенерируйте: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_REFRESH_TOKEN_TTL=604800

# ─── JWT Секреты ────────────────────────────────────────────
# ⚠️ КРИТИЧНО! Используйте РАЗНЫЕ секреты для access и refresh!
# Генерация: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_access_token_secret_min_64_chars_hex_string_here_please
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_DIFFERENT_secret_min_64_chars_here

# Время жизни токенов
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS ───────────────────────────────────────────────────
# В production — только ваш домен!
ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# ─── YooKassa ───────────────────────────────────────────────
# ⚠️ ТОЛЬКО НА БЭКЕНДЕ! Никогда не передавать на фронтенд!
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=CHANGE_ME_your_yookassa_secret_key
YOOKASSA_WEBHOOK_SECRET=CHANGE_ME_webhook_signature_secret

# ─── CDEK ───────────────────────────────────────────────────
CDEK_CLIENT_ID=CHANGE_ME_your_cdek_client_id
CDEK_CLIENT_SECRET=CHANGE_ME_your_cdek_client_secret
CDEK_API_URL=https://api.edu.cdek.ru/v2

# ─── MinIO ──────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_PRODUCTS=product-images

# ─── Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_USER=noreply@marketplace.example.ru
SMTP_PASSWORD=CHANGE_ME_smtp_password

# ─── Bcrypt ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Логирование ────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# .gitignore (добавить/исправить!):
# backend/.env          ← ОБЯЗАТЕЛЬНО!
# .env                  ← Любые .env файлы
# *.env                 ← Любые .env файлы