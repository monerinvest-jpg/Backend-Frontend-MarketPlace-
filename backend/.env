# .env.example — Шаблон переменных окружения
# ⚠️ НИКОГДА не коммитить .env в git!
# Скопируйте этот файл: cp .env.example .env
# Заполните РЕАЛЬНЫМИ значениями!

# ═══════════════════════════════════════════════
# 🖥️ ОБЩИЕ НАСТРОЙКИ
# ═══════════════════════════════════════════════

# Окружение: development | staging | production
NODE_ENV=development

# ═══════════════════════════════════════════════
# 🗄️ БАЗА ДАННЫХ — PostgreSQL
# ═══════════════════════════════════════════════

# Имя базы данных
POSTGRES_DB=marketplace_db

# Пользователь PostgreSQL (не использовать 'postgres' в prod!)
POSTGRES_USER=marketplace_user

# ⚠️ Сгенерируйте надёжный пароль: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Полная строка подключения (используется бэкендом)
DATABASE_URL=postgresql://marketplace_user:CHANGE_ME_strong_password_here@postgres:5432/marketplace_db

# Максимальный пул соединений
DB_POOL_MAX=20

# ═══════════════════════════════════════════════
# ⚡ REDIS — Кеш + Rate Limiter + Сессии
# ═══════════════════════════════════════════════

# ⚠️ Сгенерируйте: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# URL для подключения бэкенда
REDIS_URL=redis://:CHANGE_ME_redis_password_here@redis:6379

# Время хранения refresh token в Redis (в секундах, 7 дней = 604800)
REDIS_REFRESH_TOKEN_TTL=604800

# ═══════════════════════════════════════════════
# 🔑 JWT — АУТЕНТИФИКАЦИЯ
# ═══════════════════════════════════════════════

# ⚠️ КРИТИЧНО! Используйте разные секреты для access и refresh!
# Генерация: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=CHANGE_ME_access_token_secret_minimum_64_chars_long_random_string
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret_different_from_access_minimum_64_chars

# Время жизни access token (короткое!)
JWT_ACCESS_EXPIRES=15m

# Время жизни refresh token
JWT_REFRESH_EXPIRES=7d

# ═══════════════════════════════════════════════
# 🌐 CORS — РАЗРЕШЁННЫЕ ИСТОЧНИКИ
# ═══════════════════════════════════════════════

# В production — только ваш домен
ALLOWED_ORIGINS=http://localhost:3000,https://marketplace.example.ru

# URL фронтенда (для CORS и редиректов)
FRONTEND_URL=http://localhost:3000

# URL бэкенда
API_URL=http://localhost:4000

# ═══════════════════════════════════════════════
# 💳 YOOKASSA — ПЛАТЁЖНАЯ СИСТЕМА
# ═══════════════════════════════════════════════
# ⚠️ ТОЛЬКО НА БЭКЕНДЕ! Никогда не отправлять на фронтенд!

# ID магазина в YooKassa (не секретный, но не для клиента)
YOOKASSA_SHOP_ID=your_shop_id_here

# ⚠️ Секретный ключ — только на сервере!
YOOKASSA_SECRET_KEY=CHANGE_ME_your_yookassa_secret_key

# URL для webhook уведомлений от YooKassa
YOOKASSA_WEBHOOK_URL=https://api.marketplace.example.ru/api/v1/payments/webhook

# ═══════════════════════════════════════════════
# 📦 CDEK — СЛУЖБА ДОСТАВКИ
# ═══════════════════════════════════════════════
# ⚠️ ТОЛЬКО НА БЭКЕНДЕ!

CDEK_CLIENT_ID=CHANGE_ME_your_cdek_client_id
CDEK_CLIENT_SECRET=CHANGE_ME_your_cdek_client_secret

# API URL (sandbox для dev, production для prod)
CDEK_API_URL=https://api.edu.cdek.ru/v2

# ═══════════════════════════════════════════════
# 🗂️ MINIO — ХРАНИЛИЩЕ ФАЙЛОВ
# ═══════════════════════════════════════════════

MINIO_ROOT_USER=CHANGE_ME_minio_user
# ⚠️ Минимум 8 символов
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# Название бакета для изображений товаров
MINIO_BUCKET_PRODUCTS=product-images

# ═══════════════════════════════════════════════
# 📧 EMAIL — УВЕДОМЛЕНИЯ (опционально)
# ═══════════════════════════════════════════════

SMTP_HOST=smtp.example.ru
SMTP_PORT=587
SMTP_USER=noreply@marketplace.example.ru
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=Marketplace <noreply@marketplace.example.ru>

# ═══════════════════════════════════════════════
# 📊 МОНИТОРИНГ (production)
# ═══════════════════════════════════════════════

# Sentry DSN для отслеживания ошибок
SENTRY_DSN=

# Log level: error | warn | info | debug
LOG_LEVEL=info

# ═══════════════════════════════════════════════
# 🔧 BACKEND НАСТРОЙКИ
# ═══════════════════════════════════════════════

PORT=4000

# Максимальный размер загружаемого файла (в байтах, 5MB)
MAX_FILE_SIZE=5242880

# Соль для bcrypt (рекомендуется: 12)
BCRYPT_ROUNDS=12

# Максимальный размер JSON body (защита от DoS)
JSON_BODY_LIMIT=10kb

# ═══════════════════════════════════════════════
# ⚡ RATE LIMITING
# ═══════════════════════════════════════════════

# Окно rate limiting (в мс, 15 минут = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Максимум запросов на IP за окно
RATE_LIMIT_MAX_REQUESTS=100

# Строгий лимит для /auth/login
AUTH_RATE_LIMIT_MAX=5