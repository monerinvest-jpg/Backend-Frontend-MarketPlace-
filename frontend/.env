# frontend/.env
# В React (Vite) переменные должны начинаться с VITE_
# иначе они не попадут в браузер

# URL API через Kong (в production)
VITE_API_URL=http://localhost:8080/api

# Или напрямую к backend (для разработки без Kong)
# VITE_API_URL=http://localhost:8000

# URL для загрузки изображений из MinIO
VITE_MINIO_URL=http://localhost:9000/product-images