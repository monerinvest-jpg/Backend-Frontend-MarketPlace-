# .gitignore — ОБЯЗАТЕЛЬНО включить эти паттерны!

# ⚠️ КРИТИЧНО: никогда не коммитить!
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.test
*.pem
*.key
*.crt

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/

# Docker данные (локальные volume mappings)
postgres-data/
redis-data/
minio-data/

# Временные файлы
tmp/
temp/